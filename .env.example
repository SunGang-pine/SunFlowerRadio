# DeepSeek API key for SunFlowerRadio Studio.
# Copy this file to .env.local and fill in your key, or enter it in the studio.
# .env.local is ignored by git and is never served to the browser.
DEEPSEEK_API_KEY=sk-your-key-here

# Optional
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional MiniMax (an additional high-quality TTS provider)
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io
# If the key was created on the China platform, use:
# MINIMAX_BASE_URL=https://api.minimaxi.com
# MINIMAX_GROUP_ID=
# MINIMAX_MODEL=speech-2.8-hd
# MINIMAX_RPM=10
