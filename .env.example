# DeepSeek API key for SunFlowerRadio Studio.
# Copy this file to .env.local and fill in your key, or enter it in the studio.
# .env.local is ignored by git and is never served to the browser.
DEEPSEEK_API_KEY=sk-your-key-here

# Optional
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
